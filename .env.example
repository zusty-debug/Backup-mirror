# Required Telegram application configuration
BOT_TOKEN=put_botfather_token_here
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=put_api_hash_here

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=put_a_fernet_key_here

# Numeric Telegram IDs permitted to operate the bot, comma-separated
OWNER_IDS=123456789

# Local paths (absolute paths are recommended in Docker)
DATA_DIR=./data
DATABASE_PATH=./data/mirror.db
TEMP_DIR=./data/tmp
REPORT_DIR=./data/reports

# Long polling is recommended for the first deployment.
STATUS_UPDATE_SECONDS=2
MAX_SENDS_PER_MINUTE=100
SYNC_POLL_SECONDS=300
MAX_PROJECTS_PER_OWNER=20
MAX_CONCURRENT_BACKUPS=2
MAX_ACTIVE_PROJECTS_PER_USER=1
MAX_UPLOAD_RETRIES=4
LOG_LEVEL=INFO
